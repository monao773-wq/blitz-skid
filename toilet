-- Toggle between third-person and first-person camera modes.  This
-- modified toggle enforces third-person view every frame when enabled
-- to combat other scripts that might lock the camera.  Disabling the
-- toggle reverts to first-person and stops the enforcement loop.
Tab3:AddToggle({
    Name    = "三人称視点 (Third Person View)",
    Default = true,
    Callback = function(v)
        if v then
            -- Save the player's current zoom settings so we can restore them later
            prevMinZoom = LocalPlayer.CameraMinZoomDistance
            prevMaxZoom = LocalPlayer.CameraMaxZoomDistance
            -- ensure the player can zoom out in third person
            -- Setting the min zoom to 0 allows the player to zoom close, while
            -- the max zoom determines how far they can zoom out.
            pcall(function()
                LocalPlayer.CameraMinZoomDistance = 0
                LocalPlayer.CameraMaxZoomDistance = 128
            end)
            -- set camera mode to Classic to allow third person and set the camera type
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            local cam = workspace.CurrentCamera
            if cam then
                cam.CameraType = Enum.CameraType.Custom
            end
            -- disconnect any previous enforcement loop before connecting a new one
            if thirdPersonConn then
                thirdPersonConn:Disconnect()
                thirdPersonConn = nil
            end
            -- enforce Classic mode, camera type, and zoom bounds each frame.  Some games
            -- continually overwrite these properties, so we set them on RenderStepped
            thirdPersonConn = RunService.RenderStepped:Connect(function()
                if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
                    LocalPlayer.CameraMode = Enum.CameraMode.Classic
                end
                local cam2 = workspace.CurrentCamera
                if cam2 then
                    if cam2.CameraType ~= Enum.CameraType.Custom then
                        cam2.CameraType = Enum.CameraType.Custom
                    end
                end
                -- maintain zoom distances; occasionally game scripts clamp these
                if prevMinZoom ~= nil and LocalPlayer.CameraMinZoomDistance ~= 0 then
                    LocalPlayer.CameraMinZoomDistance = 0
                end
                if prevMaxZoom ~= nil and LocalPlayer.CameraMaxZoomDistance < 128 then
                    LocalPlayer.CameraMaxZoomDistance = 128
                end
            end)
        else
            -- user disabled third person; disconnect enforcement and restore settings
            if thirdPersonConn then
                thirdPersonConn:Disconnect()
                thirdPersonConn = nil
            end
            -- restore original zoom distances if saved
            if prevMinZoom ~= nil then
                pcall(function()
                    LocalPlayer.CameraMinZoomDistance = prevMinZoom
                end)
            end
            if prevMaxZoom ~= nil then
                pcall(function()
                    LocalPlayer.CameraMaxZoomDistance = prevMaxZoom
                end)
            end
            prevMinZoom, prevMaxZoom = nil, nil
            -- set camera back to first person lock
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
            -- optionally set camera type to default so other systems don't conflict
            local cam = workspace.CurrentCamera
            if cam then
                cam.CameraType = Enum.CameraType.Custom
            end
        end
    end
})

