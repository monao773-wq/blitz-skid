-- Spawn a new toilet near the player.  This clones an existing toilet model
-- (either white or gold) from the workspace and positions the clone near the
-- player's character.  The clone is unanchored, has collisions enabled, and
-- its network ownership is assigned to the local player for smooth client
-- control.  After spawning, we optionally rescan the workspace so the new
-- object joins the orbit if orbiting is enabled.
local function spawnToilet()
    local root = HRP()
    if not root then return end
    -- Find a sample toilet model in the workspace to clone.  Prefer white over gold
    local sample = nil
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("Model") and (desc.Name == "ToiletWhite" or desc.Name == "ToiletGold") then
            sample = desc
            if desc.Name == "ToiletWhite" then
                break
            end
        end
    end
    if not sample then return end
    -- Clone the model and parent it to the workspace
    local clone = sample:Clone()
    clone.Parent = Workspace
    -- Position slightly above the player with a random horizontal offset
    local pos = root.Position + Vector3.new(math.random(-5,5), 5, math.random(-5,5))
    -- Use MoveTo for consistent behaviour and call MakeJoints to rebuild any welds
    pcall(function()
        clone:MoveTo(pos)
    end)
    pcall(function()
        clone:MakeJoints()
    end)
    -- Configure all parts in the clone
    for _, bp in ipairs(clone:GetDescendants()) do
        if bp:IsA("BasePart") then
            bp.Anchored = false
            bp.CanCollide = true
            bp.CanTouch   = true
            -- Assign network ownership to the local player for smooth physics
            pcall(function() bp:SetNetworkOwner(LocalPlayer) end)
        end
    end
    -- If orbiting is enabled, include the new toilet in the orbit
    if Enabled then
        rescan()
    end
end

