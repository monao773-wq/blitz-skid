-- Configuration variables
local Enabled     = false
local Mode        = "Orbit"
local Speed       = 1200
local Radius      = 12
local Height      = 6
local MaxVel      = 700
local Strength    = 16
local AutoSwitch  = false
local SwitchSec   = 2.0
local Petals      = 7       -- used for Flower mode
local VertAmp     = 2.5     -- used for Helix mode
local VBounce     = true
local VHeight     = 8
local VSpeedUp    = 1.2
local VSpeedDown  = 1.2

-- Target sets map names to model lists.  “Sparkler” selects fireworks,
-- while “Toilet” selects both white and gold toilets.
local TargetSet = "Sparkler"
local TargetSets = {
    ["Sparkler"] = {"FireworkSparkler"},
    ["Toilet"]   = {"ToiletWhite", "ToiletGold"}
}

-- Internal state
local objects        = {}       -- list of {model, part}
local loopConn       = nil      -- connection to the orbit loop
local switchTimer    = 0        -- timer for auto-switching modes
local modesCycle     = {"Orbit","Heart","Star","Square","Infinity",
                        "Spiral","Flower","Helix","LOL","Octagon"}
local yPhase, yDirection = 0, 1

-- Additional state for third‑person enforcement
local thirdPersonConn = nil
-- store previous zoom values when toggling third person so we can restore them
local prevMinZoom, prevMaxZoom = nil, nil

-- Helper: get the humanoid root part of the local player
local function HRP()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return character:FindFirstChild("HumanoidRootPart")
end

-- Helper: find a base part in a model (prefers PrimaryPart)
local function getPartFromModel(m)
    if m.PrimaryPart then return m.PrimaryPart end
    return m:FindFirstChildWhichIsA("BasePart")
end

-- Attach BodyVelocity and BodyGyro to a part so we can move/rotate it
local function attachPhysics(part)
    if not part or not part.Parent then return end
    -- set network owner so the client controls physics for this part
    pcall(function() part:SetNetworkOwner(LocalPlayer) end)
    part.CanCollide, part.CanTouch = false, false
    if not part:FindFirstChild("BodyVelocity") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "BodyVelocity"
        bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        bv.P = 1e6
        bv.Velocity = Vector3.new()
        bv.Parent = part
    end
    if not part:FindFirstChild("BodyGyro") then
        local bg = Instance.new("BodyGyro")
        bg.Name = "BodyGyro"
        bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        bg.P = 1e6
        bg.CFrame = part.CFrame
        bg.Parent = part
    end
end

-- Detach BodyVelocity and BodyGyro from a part when disabling
local function detachPhysics(part)
    if not part then return end
    local bv = part:FindFirstChild("BodyVelocity"); if bv then bv:Destroy() end
    local bg = part:FindFirstChild("BodyGyro");    if bg then bg:Destroy() end
    part.CanCollide, part.CanTouch = true, true
    pcall(function() part:SetNetworkOwner(nil) end)
end

-- Check if a model name is in the current target set
local function nameInTargets(name)
    local tset = TargetSets[TargetSet]
    if not tset then return false end
    for _,n in ipairs(tset) do
        if name == n then return true end
    end
    return false
end

-- Rescan the workspace for matching models
local function rescan()
    -- detach physics from existing objects
    for _,obj in ipairs(objects) do
        if obj.part then detachPhysics(obj.part) end
    end
    objects = {}
    local tset = TargetSets[TargetSet]
    if not tset then return end
    for _,desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("Model") and nameInTargets(desc.Name) then
            local part = getPartFromModel(desc)
            if part and not part.Anchored then
                table.insert(objects, {model=desc, part=part})
            end
        end
    end
    -- attach physics to new objects
    for i=1,#objects do
        attachPhysics(objects[i].part)
    end
end

-- Construct a list of points that draw the letters “LOL” when orbiting.
local function buildLOL(scale)
    local pts = {}
    local function push(v) pts[#pts+1] = v end
    -- build the L
    for z=0,10 do push(Vector3.new(0,0,z*scale)) end
    for x=0,6  do push(Vector3.new(x*scale,0,10*scale)) end
    -- build the O
    local r = 4.5*scale
    for i=0,21 do
        local t=(i/22)*math.pi*2
        push(Vector3.new(12*scale+math.cos(t)*r,0,5*scale+math.sin(t)*r))
    end
    -- build the second L
    for z=0,10 do push(Vector3.new(24*scale,0,z*scale)) end
    for x=0,6  do push(Vector3.new(24*scale+x*scale,0,10*scale)) end
    return pts
end

local lolPts = buildLOL(1.8)

-- Determine the target offset for the j‑th object at time t
local function targetFor(j, n, t)
    local ang = math.rad(Speed) * t + (j-1)/math.max(1,n) * math.pi*2
    local r = Radius
    if Mode == "Orbit" then
        return Vector3.new(math.cos(ang)*r, 0, math.sin(ang)*r)
    elseif Mode == "Heart" then
        local x = 16*math.sin(ang)^3
        local y = 13*math.cos(ang)-5*math.cos(2*ang)-2*math.cos(3*ang)-math.cos(4*ang)
        return Vector3.new((x*r/13), 0, (y*r/13))
    elseif Mode == "Star" then
        local k = 5
        local rr = (math.cos(k*ang) > 0) and r or r*0.45
        return Vector3.new(rr*math.cos(ang), 0, rr*math.sin(ang))
    elseif Mode == "Square" then
        local p = (ang%(2*math.pi))/(2*math.pi)
        local s = r*2
        local h = s/2
        local x,z
        if p < 0.25 then
            x = h; z = -h + 4*h*p
        elseif p < 0.5 then
            x = h - 4*h*(p-0.25); z = h
        elseif p < 0.75 then
            x = -h; z = h - 4*h*(p-0.5)
        else
            x = -h + 4*h*(p-0.75); z = -h
        end
        return Vector3.new(x, 0, z)
    elseif Mode == "Infinity" then
        return Vector3.new(r*math.cos(ang), 0, r*math.sin(ang)*math.cos(ang))
    elseif Mode == "Spiral" then
        local rr = math.clamp(0.20*Speed*(t%5), 0, r)
        return Vector3.new(rr*math.cos(ang), 0, rr*math.sin(ang))
    elseif Mode == "LOL" then
        if #lolPts == 0 then lolPts = buildLOL(1.8) end
        local idx = ((j-1) % #lolPts) + 1
        return lolPts[idx]
    elseif Mode == "Flower" then
        local rr = r * (0.55 + 0.45*math.cos(Petals*ang))
        return Vector3.new(rr*math.cos(ang), 0, rr*math.sin(ang))
    elseif Mode == "Helix" then
        local yVal = VertAmp * math.sin(ang*2 + j*0.8)
        return Vector3.new(r*math.cos(ang), yVal, r*math.sin(ang))
    elseif Mode == "Octagon" then
        local sides = 8
        local step = (2*math.pi)/sides
        local p = (ang % (2*math.pi)) / step
        local idx = math.floor(p)
        local frac = p - idx
        local a1 = idx * step
        local a2 = (idx + 1) * step
        local v1 = Vector3.new(math.cos(a1)*r, 0, math.sin(a1)*r)
        local v2 = Vector3.new(math.cos(a2)*r, 0, math.sin(a2)*r)
        return v1:Lerp(v2, frac)
    end
    -- default: circle
    return Vector3.new(r, 0, 0)
end

-- Start the orbiting loop
local function startLoop()
    if loopConn then loopConn:Disconnect() loopConn = nil end
    local tAccum = 0
    switchTimer = 0
    loopConn = RunService.Heartbeat:Connect(function(dt)
        local root = HRP(); if not root then return end
        tAccum += dt

        -- auto cycle through modes
        if AutoSwitch and SwitchSec > 0 then
            switchTimer += dt
            if switchTimer >= SwitchSec then
                switchTimer = 0
                local idx = 1
                for i,m in ipairs(modesCycle) do
                    if m == Mode then idx = i; break end
                end
                Mode = modesCycle[(idx % #modesCycle) + 1]
            end
        end

        -- vertical bounce effect
        local rate = (yDirection > 0) and VSpeedUp or VSpeedDown
        yPhase = yPhase + yDirection * rate * dt * 2
        if yPhase >= 1 then yPhase = 1; yDirection = -1 end
        if yPhase <= -1 then yPhase = -1; yDirection = 1 end
        local yosc = VBounce and (VHeight * yPhase) or 0

        -- compute the center above the player
        local baseCenter = root.Position + Vector3.new(0, Height, 0)
        local center = baseCenter + Vector3.new(0, yosc, 0)

        -- update each object
        for j = 1, #objects do
            local rec = objects[j]; local p = rec and rec.part
            if p and p.Parent then
                local off = targetFor(j, #objects, tAccum)
                local targetPos = center + off
                local dir = targetPos - p.Position
                local d = dir.Magnitude
                local bv = p:FindFirstChild("BodyVelocity")
                if bv then
                    bv.Velocity = (d > 0.02) and dir.Unit * math.min(MaxVel, d*Strength) or Vector3.new()
                end
                local bg = p:FindFirstChild("BodyGyro")
                if bg then bg.CFrame = CFrame.new(p.Position, center) end
            end
        end
    end)
end

-- Stop the orbiting loop and detach physics
local function stopLoop()
    if loopConn then loopConn:Disconnect() loopConn = nil end
end

-- Hook into workspace changes so new models join the orbit automatically
Workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("Model") and Enabled and nameInTargets(inst.Name) then
        task.wait(0.1)
        rescan()
    end
end)

Workspace.DescendantRemoving:Connect(function(inst)
    if inst:IsA("Model") and Enabled and nameInTargets(inst.Name) then
        task.defer(rescan)
    end
end)

