-- [[ 1. ライブラリのセットアップ ]]
-- 外部読み込みを安定させるため、Rayfield公式の最も安定したパスを使用
local success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not success then return end -- 読み込めない場合は即座に終了（エラーを出さない）

-- [[ 2. ウィンドウ設定（そらりす並の安定性） ]]
local Window = Rayfield:CreateWindow({
   Name = "OVERDRIVE", -- 名前を極限まで短縮
   LoadingTitle = "...",
   LoadingSubtitle = "",
   ConfigurationSaving = { Enabled = false }
})

-- [[ 3. 変数設定（そらりす.txt の内部ロジックを継承） ]]
local State = {
    Enabled = false,
    Delay = 0.01,
    Algorithm = "Stepped" -- そらりす基準の高速モード
}

-- [[ 4. タブ & 機能 ]]
local Tab = Window:CreateTab("Combat", nil)

Tab:CreateToggle({
   Name = "AUTO TAP",
   CurrentValue = false,
   Callback = function(Value) State.Enabled = Value end,
})

Tab:CreateSlider({
   Name = "Speed",
   Range = {0.001, 0.05},
   Increment = 0.001,
   CurrentValue = 0.01,
   Callback = function(Value) State.Delay = Value end,
})

-- [[ 5. 超高速連打エンジン（ロガー・通知一切なし） ]]
task.spawn(function()
    local RunService = game:GetService("RunService")
    
    while true do
        if State.Enabled then
            -- そらりす.txt で採用されていた Stepped 同期をさらに高速化
            RunService.Stepped:Wait() 
            
            if mouse1click then
                mouse1click()
                -- 二重パケット（火力を既存の倍にする改良）
                mouse1click()
            end
            
            -- 人間には不可能な 0.0001秒単位のランダム揺らぎ
            task.wait(State.Delay + (math.random(-10, 10) / 10000))
        else
            task.wait(0.5)
        end
    end
end)

-- 通知コード（Rayfield:Notify）とロガー（Pastefy等）は完全に削除済み
