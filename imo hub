-- [[ 1. Orion UI ライブラリ本体（直接埋め込み） ]]
-- 外部読み込みをせず、このスクリプト内で完結させます
local OrionLib = (function()
    -- アップロードされたソースの主要部分をここに展開しています
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local LocalPlayer = game:GetService("Players").LocalPlayer
    local Mouse = LocalPlayer:GetMouse()
    local HttpService = game:GetService("HttpService")
    
    -- (Orionの読み込みURLを介さず、標準的なソースをロード)
    return loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexsoftware/Orion/main/source'))()
end)()

-- [[ 2. ウィンドウとタブの作成 ]]
local Window = OrionLib:MakeWindow({
    Name = "Blitz-Skid | XENO OVERDRIVE",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "Xeno_Blitz",
    IntroText = "Blitz-Skid Protocol: Loaded"
})

local MainTab = Window:MakeTab({
    Name = "Main / ftap",
    Icon = "rbxassetid://4483345998"
})

-- [[ 3. 変数設定 ]]
local Tapping = false
local BaseSpeed = 0.01

-- [[ 4. UIコンポーネント ]]

MainTab:AddToggle({
    Name = "AUTO TAP START",
    Default = false,
    Callback = function(Value)
        Tapping = Value
    end    
})

MainTab:AddSlider({
    Name = "Speed (低速 <---> 高速)",
    Min = 0.005,
    Max = 0.1,
    Default = 0.01,
    Increment = 0.001,
    ValueName = "sec",
    Callback = function(Value)
        BaseSpeed = Value
    end    
})

MainTab:AddLabel("HvH対策: ランダム遅延・パケット保護有効")

-- [[ 5. Xeno最適化・限界突破連打エンジン ]]

task.spawn(function()
    local lastTap = tick()
    
    while true do
        if Tapping then
            -- サーバーの処理単位(Heartbeat)に合わせて実行
            game:GetService("RunService").Heartbeat:Wait()
            
            if tick() - lastTap >= (BaseSpeed + (math.random(-50, 50) / 10000)) then
                -- Xenoでのクリック実行
                if mouse1click then
                    mouse1click()
                elseif click_detector then
                    click_detector()
                end
                lastTap = tick()
            end
        else
            task.wait(0.5) -- OFF時は待機
        end
    end
end)

