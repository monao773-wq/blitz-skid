-- [[ 1. Orion UI ライブラリの初期化 ]]
-- 外部サーバーからOrionの機能を呼び出します
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexsoftware/Orion/main/source')))()

-- [[ 2. メインウィンドウの設定 ]]
local Window = OrionLib:MakeWindow({
    Name = "Blitz-Skid | OVERDRIVE HvH",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "BlitzSkid_Config",
    IntroText = "System Secured: Ready to Dominate"
})

-- [[ 3. 変数管理（検知回避用） ]]
local Tapping = false
local BaseSpeed = 0.015
local AntiKick = true

-- [[ 4. タブ作成 ]]
local MainTab = Window:MakeTab({
    Name = "Main / ftap",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- [[ 5. UIコンポーネントの構築 ]]

MainTab:AddToggle({
    Name = "AUTO TAP ENABLED (自動タップ)",
    Default = false,
    Callback = function(Value)
        Tapping = Value
    end    
})

MainTab:AddSlider({
    Name = "Tap Speed (秒)",
    Min = 0.005,
    Max = 0.1,
    Default = 0.015,
    Increment = 0.001,
    ValueName = "sec",
    Callback = function(Value)
        BaseSpeed = Value
    end    
})

MainTab:AddToggle({
    Name = "Anti-Kick Mode (検知回避)",
    Default = true,
    Callback = function(Value)
        AntiKick = Value
    end    
})

MainTab:AddLabel("警告: 低速設定はサーバーキックのリスクを下げます")

-- [[ 6. 限界突破：連打エンジンコア ]]
-- Xenoなどのエグゼキューターで最も安定するHeartbeat同期を採用

task.spawn(function()
    local RunService = game:GetService("RunService")
    local tapCount = 0
    local burstLimit = math.random(10, 20)
    
    while true do
        if Tapping then
            -- サーバーの物理演算サイクルに同期（機械的リズムを隠す）
            RunService.Heartbeat:Wait()
            
            -- クリック実行
            if mouse1click then
                mouse1click()
                tapCount = tapCount + 1
            end
            
            -- 遅延計算（アンチキック対策）
            local finalDelay = BaseSpeed
            if AntiKick then
                -- 0.0001秒単位で毎回リズムを変える（統計検知対策）
                local jitter = math.random(-50, 50) / 10000
                finalDelay = finalDelay + jitter
                
                -- 定期的に「指を離す」瞬間を模倣（レートリミット対策）
                if tapCount >= burstLimit then
                    task.wait(finalDelay + 0.05)
                    tapCount = 0
                    burstLimit = math.random(10, 25)
                end
            end
            
            task.wait(finalDelay)
        else
            -- OFF時は負荷をかけない
            task.wait(0.5)
        end
    end
end)

