-- [[ 1. Rayfield UI 本体のロード ]]
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- [[ 2. ウィンドウ設定（一切の通知・ロゴを排除） ]]
local Window = Rayfield:CreateWindow({
   Name = "BLITZ-SKID | HvH PROTOCOL",
   LoadingTitle = "...",
   LoadingSubtitle = "",
   ConfigurationSaving = { Enabled = false }
})

-- [[ 3. HvH専用・戦闘パラメータ ]]
local HvH = {
    Tapping = false,
    Delay = 0.01,
    Power = 1, -- 1フレームあたりのクリック数
    Jitter = true, -- 検知回避
    BurstMode = false -- バースト連打
}

-- [[ 4. 戦闘用タブ構築 ]]
local CombatTab = Window:CreateTab("Combat / HvH", 4483345998)

CombatTab:CreateSection("Main Offensive")

CombatTab:CreateToggle({
   Name = "AUTO TAP (KILLER)",
   CurrentValue = false,
   Callback = function(v) HvH.Tapping = v end,
})

CombatTab:CreateSlider({
   Name = "Attack Speed",
   Range = {0.001, 0.05},
   Increment = 0.001,
   CurrentValue = 0.01,
   Callback = function(v) HvH.Delay = v end,
})

CombatTab:CreateSection("HvH Optimizations")

CombatTab:CreateDropdown({
   Name = "Power Multiplier",
   Options = {"x1 (Stable)", "x2 (Heavy)", "x3 (Overload)"},
   CurrentOption = "x1 (Stable)",
   Callback = function(Option)
      if Option == "x1 (Stable)" then HvH.Power = 1
      elseif Option == "x2 (Heavy)" then HvH.Power = 2
      elseif Option == "x3 (Overload)" then HvH.Power = 3 end
   end,
})

CombatTab:CreateToggle({
   Name = "Anti-Cheat Jitter",
   CurrentValue = true,
   Callback = function(v) HvH.Jitter = v end,
})

-- [[ 5. 強化版：HvH連打エンジン（そらりす同期式） ]]
task.spawn(function()
    local RunService = game:GetService("RunService")
    
    while true do
        if HvH.Tapping then
            -- Stepped同期（物理演算より手前でパケットを投げる）
            RunService.Stepped:Wait()
            
            pcall(function()
                if mouse1click then
                    -- Power倍率分だけパケットを多重送信
                    for i = 1, HvH.Power do
                        mouse1click()
                    end
                end
            end)
            
            -- 検知回避とパケット密度の調整
            local waitTime = HvH.Delay
            if HvH.Jitter then
                waitTime = waitTime + (math.random(-15, 15) / 10000)
            end
            task.wait(waitTime)
        else
            task.wait(0.5)
        end
    end
end)

-- ロガーや起動通知は一切含まれていません。
Rayfield:LoadConfiguration()
