-- [[ 1. Orion UIを直接読み込み ]]
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexsoftware/Orion/main/source')))()

-- [[ 2. ウィンドウ作成 ]]
local Window = OrionLib:MakeWindow({
    Name = "Blitz-Skid | ULTIMATE HvH",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "BlitzSkid_v2"
})

-- [[ 3. あなた専用のftap機能を追加 ]]
local MainTab = Window:MakeTab({
    Name = "Auto Tap",
    Icon = "rbxassetid://4483345998"
})

local Active = false
local BaseSpeed = 0.015

MainTab:AddToggle({
    Name = "OVERDRIVE START",
    Default = false,
    Callback = function(Value) Active = Value end    
})

MainTab:AddSlider({
    Name = "Speed",
    Min = 0.01, Max = 0.1, Default = 0.015, Increment = 0.001,
    Callback = function(Value) BaseSpeed = Value end    
})

-- ループ処理
task.spawn(function()
    while true do
        if Active then
            if mouse1click then mouse1click() end
            task.wait(BaseSpeed + (math.random(-50, 50) / 10000))
        else
            task.wait(0.5)
        end
    end
end)


OrionLib:Init()
