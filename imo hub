-- [[ 1. Rayfield UI ロード ]]
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- [[ 2. ウィンドウ設定（一切の通知・ロゴなし） ]]
local Window = Rayfield:CreateWindow({
   Name = "BLITZ HvH | FINAL PROTOCOL",
   LoadingTitle = "HvH System Loading...",
   LoadingSubtitle = "",
   ConfigurationSaving = { Enabled = false }
})

-- [[ 3. HvH 変数管理 ]]
local State = {
    AntiGrab = false,
    AntiKick = false,
    LoopKill = false,
    LoopKick = false,
    Target = "",
    PacketBurst = false
}

-- [[ 4. Tab 1: Defensive (防御) ]]
local DefTab = Window:CreateTab("Defense", nil)

DefTab:CreateToggle({
   Name = "Anti-Grab (掴み無効)",
   CurrentValue = false,
   Callback = function(v) State.AntiGrab = v end,
})

DefTab:CreateToggle({
   Name = "Anti-Kick (自身へのKick防止)",
   CurrentValue = false,
   Callback = function(v) State.AntiKick = v end,
})

-- [[ 5. Tab 2: Offensive (攻撃) ]]
local OffTab = Window:CreateTab("Attack / Loop", nil)

OffTab:CreateInput({
   Name = "Target Player Name",
   PlaceholderText = "Player Name...",
   RemoveTextAfterFocusLost = false,
   Callback = function(v) State.Target = v end,
})

OffTab:CreateToggle({
   Name = "Loop Kill (連続キル)",
   CurrentValue = false,
   Callback = function(v) State.LoopKill = v end,
})

OffTab:CreateToggle({
   Name = "Loop Kick (連続追放試行)",
   CurrentValue = false,
   Callback = function(v) State.LoopKick = v end,
})

OffTab:CreateSection("Packet Attack")

OffTab:CreateToggle({
   Name = "Anti-Blobman / Gucci Mode",
   CurrentValue = false,
   Callback = function(v) State.PacketBurst = v end,
})

-- [[ 6. HvH コアロジック (そらりす同期) ]]
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

task.spawn(function()
    RunService.Stepped:Connect(function()
        -- Anti-Grab: キャラクターのパーツが掴まれるのを防ぐためにCFrameを微調整
        if State.AntiGrab and LP.Character then
            for _, v in pairs(LP.Character:GetChildren()) do
                if v:IsA("BasePart") then v.CanTouch = true end
            end
        end

        -- Loop Kill / Kick 簡易ロジック
        if (State.LoopKill or State.LoopKick) and State.Target ~= "" then
            local targetPlayer = Players:FindFirstChild(State.Target)
            if targetPlayer then
                -- ここにゲームごとのRemoteEvent（Damage/Kick）を叩く処理を入れる
                -- ※ mouse1clickを応用してパケットを送り続ける
                if mouse1click then mouse1click() end
            end
        end

        -- Anti-Kick: サーバーからのKick命令をpcallで無視し続ける
        if State.AntiKick then
            pcall(function()
                LP.OnTeleport = function() return end
            end)
        end
    end)
end)

-- 通知・ロガーは一切ありません。
Rayfield:LoadConfiguration()
